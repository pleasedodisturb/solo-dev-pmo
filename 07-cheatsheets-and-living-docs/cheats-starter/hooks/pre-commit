#!/usr/bin/env bash
# Refresh "last-validated" on staged *-cheatsheet.md files, then re-stage.
set -euo pipefail
today=$(date +%F)
changed=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\-cheatsheet\.md$' || true)
[ -z "$changed" ] && exit 0
while IFS= read -r f; do
  [ -f "$f" ] || continue
  if grep -q 'last-validated:' "$f"; then
    sed -i -E "s/last-validated: [0-9]{4}-[0-9]{2}-[0-9]{2}/last-validated: ${today}/" "$f"
  fi
  git add "$f"
done <<< "$changed"
