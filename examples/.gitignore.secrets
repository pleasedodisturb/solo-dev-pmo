# Secrets-focused .gitignore patterns
# Append (don't replace) your project's existing .gitignore with these patterns.

# Secret files
.env
.env.local
.env.*.local
.envrc
*.key
*.pem
*.crt
*.p12
*.pfx
secrets/
private-keys/
credentials/
keys/

# Tool-specific token files
.linear_api_token
.anthropic_token
.openai_token
.aws/credentials
.docker/config.json
.kube/config
.netrc

# Tool-specific config that may contain secrets
.claude/settings.local.json
.mcp.local.json

# Editor backups that may contain secrets
*.swp
*.swo
*~
.DS_Store
.vscode/settings.json

# Local dev databases (may have prod data snapshots)
*.sqlite
*.sqlite3
*.db
db.sqlite3
local.db

# Build artifacts that may bundle secrets
node_modules/
.venv/
venv/
dist/
build/
*.pyc
__pycache__/
.next/
.nuxt/

# Log files that may contain secrets
*.log
logs/
